    {
      "name": "Pagination GET",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Pagination returns 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Pagination data is correct\", function () {\r\n    const data = pm.response.json();\r\n\r\n    pm.expect(data.totalDonations).to.be.a(\"number\");\r\n    pm.expect(data.totalPages).to.be.a(\"number\");\r\n    pm.expect(data.currentPage).to.eql(1);\r\n    pm.expect(data.pageSize).to.be.at.most(200);\r\n    pm.expect(data.donations).to.be.an(\"array\");\r\n});\r\n\r\npm.test(\"Anonymous donor names are hidden\", function () {\r\n    const donations = pm.response.json().donations;\r\n\r\n    donations.forEach(function (donation) {\r\n        if (donation.isAnonymous) {\r\n            pm.expect(donation.donorName).to.eql(\"Anonymous\");\r\n        }\r\n    });\r\n});"
            ]
          }
        }
      ],
